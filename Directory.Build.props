<Project>

  <!--
    Properties hoisted here apply to every project in the solution.
    Project-specific overrides can still appear in individual .csproj files.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Enforce .editorconfig style rules during dotnet build / CI -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Enable the latest recommended set of .NET analysers -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <!-- Fail the build on any compiler warning so issues are caught early -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!--
      Required for IDE0005 (remove unnecessary usings) to work during dotnet build.
      CS1591 (missing XML doc comment) is suppressed below in .editorconfig until
      full API documentation is added.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- SemVer from annotated vX.Y.Z tags (see specs/018-in-app-about-version/research.md) -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>preview</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

  <!-- Optional CI-generated build metadata (see deploy-staging.yml); explicit /p: properties still win when set earlier. -->
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.metadata.props" Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.metadata.props')" />

  <ItemGroup>
    <PackageReference Include="MinVer">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'$(SourceRevisionId)' != ''">
      <_Parameter1>SourceRevisionId</_Parameter1>
      <_Parameter2>$(SourceRevisionId)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'$(BuildTimestampUtc)' != ''">
      <_Parameter1>BuildTimestampUtc</_Parameter1>
      <_Parameter2>$(BuildTimestampUtc)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'$(OfficialReleaseBuild)' == 'true'">
      <_Parameter1>OfficialReleaseBuild</_Parameter1>
      <_Parameter2>true</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
