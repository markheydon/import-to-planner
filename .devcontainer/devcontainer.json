{
  "name": "Import To Planner",
  "image": "mcr.microsoft.com/devcontainers/base:3-ubuntu24.04",
  "features": {
    "ghcr.io/microsoft/aspire-devcontainer-feature/aspire:3": {},
    "ghcr.io/devcontainers/features/azure-cli:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/docker-in-docker:4": {},
    "ghcr.io/devcontainers/features/python:1": {
      "version": "os-provided"
    },
    "ghcr.io/devcontainers-extra/features/uv:1": {},
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "10.0"
    },
    "ghcr.io/devcontainers/features/powershell:2": {},
    "ghcr.io/stu-bell/devcontainer-features/cursor-cli:0": {}
  },
  "onCreateCommand": "sudo apt-get update && sudo apt-get install -y libnss3-tools",
  "updateContentCommand": "dotnet restore ImportToPlanner.slnx && dotnet restore src/ImportToPlanner.AppHost/ImportToPlanner.AppHost.csproj",
  "containerEnv": {
    "SSL_CERT_DIR": "/home/vscode/.aspnet/dev-certs/trust:/usr/lib/ssl/certs"
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "forwardPorts": [5126, 7129],
  "portsAttributes": {
    "5126": {
      "label": "Import To Planner HTTP",
      "onAutoForward": "notify"
    },
    "7129": {
      "label": "Import To Planner HTTPS",
      "onAutoForward": "openBrowser"
    }
  },
  "postStartCommand": "dotnet dev-certs https --trust && aspire certs trust --non-interactive",
  "postCreateCommand": "bash .devcontainer/setup-spec-kit.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "GitHub.copilot-chat",
        "microsoft-aspire.aspire-vscode"
      ]
    }
  }
}
