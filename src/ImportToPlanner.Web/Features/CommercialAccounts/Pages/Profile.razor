@page "/profile"

<PageTitle>Your profile</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-6">
    <MudStack Spacing="3">
        <MudPaper Elevation="0" Outlined="true" Class="pa-4 pa-md-6">
            <MudStack Spacing="1">
                <MudText Typo="Typo.h4">Your profile</MudText>
                <MudText Typo="Typo.body2">
                    This page shows the account details currently stored for your account.
                </MudText>
            </MudStack>
        </MudPaper>

        @if (!string.IsNullOrWhiteSpace(statusMessage))
        {
            <MudAlert Severity="@statusSeverity" Dense="true">
                <MudText Typo="Typo.body2">@statusMessage</MudText>
            </MudAlert>
        }

        @if (showSignInPrompt)
        {
            <MudPaper Elevation="0" Outlined="true" Class="pa-4 pa-md-6">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.body1">Sign in to view and manage your account.</MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OnSignInClicked">Sign in</MudButton>
                </MudStack>
            </MudPaper>
        }
        else if (isBusy)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else if (account is null)
        {
            <MudPaper Elevation="0" Outlined="true" Class="pa-4 pa-md-6">
                <MudText Typo="Typo.body1">No account record was found for this session.</MudText>
            </MudPaper>
        }
        else
        {
            <MudPaper Elevation="0" Outlined="true" Class="pa-4 pa-md-6">
                <MudStack Spacing="2">
                    <MudText Typo="Typo.h6">Stored account details</MudText>
                    <MudSimpleTable Dense="true" Elevation="0">
                        <tbody>
                            <tr>
                                <th>Tenant ID</th>
                                <td>@account.TenantId</td>
                            </tr>
                            <tr>
                                <th>User ID</th>
                                <td>@account.UserId</td>
                            </tr>
                            <tr>
                                <th>Created</th>
                                <td>@account.CreatedUtc.UtcDateTime.ToString("dd MMM yyyy", System.Globalization.CultureInfo.InvariantCulture)</td>
                            </tr>
                        </tbody>
                    </MudSimpleTable>
                </MudStack>
            </MudPaper>

            @if (showCreditsSection)
            {
                <MudPaper Elevation="0" Outlined="true" Class="pa-4 pa-md-6">
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.h6">@ProfileCreditPresenter.BuildCreditsSectionHeading()</MudText>

                        @if (creditSummaryLoading)
                        {
                            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                        }
                        else if (!string.IsNullOrWhiteSpace(creditBalanceErrorMessage))
                        {
                            <MudAlert Severity="Severity.Error" Dense="true">
                                <MudText Typo="Typo.body2">@creditBalanceErrorMessage</MudText>
                            </MudAlert>
                        }
                        else if (creditSummary is not null)
                        {
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.subtitle2">@ProfileCreditPresenter.BuildRemainingLabel()</MudText>
                                <MudText Typo="Typo.h5">@ProfileCreditPresenter.FormatRemainingCredits(creditSummary)</MudText>
                                @if (creditSummary.ComplimentaryUnlimitedAccess)
                                {
                                    <MudText Typo="Typo.body2">@ProfileCreditPresenter.BuildComplimentaryRemainingDescription()</MudText>
                                }
                            </MudStack>

                            @if (!creditSummary.ComplimentaryUnlimitedAccess && creditSummary.FreeMonthlyLot is not null)
                            {
                                <MudDivider Class="my-2" />
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.subtitle2">@ProfileCreditPresenter.BuildFreeMonthlyLotHeading()</MudText>
                                    <MudText Typo="Typo.body2">@ProfileCreditPresenter.BuildFreeMonthlyGrantedCopy(creditSummary.FreeMonthlyLot.GrantedQuantity)</MudText>
                                    <MudText Typo="Typo.body2">@ProfileCreditPresenter.BuildFreeMonthlyRemainingCopy(creditSummary.FreeMonthlyLot.RemainingQuantity)</MudText>
                                    <MudText Typo="Typo.body2">@ProfileCreditPresenter.BuildFreeMonthlyExpiryCopy(creditSummary.FreeMonthlyLot.ExpiresAtUtc)</MudText>
                                </MudStack>
                            }

                            @if (!creditSummary.ComplimentaryUnlimitedAccess && creditSummary.PaidLots.Count > 0)
                            {
                                <MudDivider Class="my-2" />
                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.subtitle2">@ProfileCreditPresenter.BuildPaidLotsHeading()</MudText>
                                    @foreach (var paidLot in creditSummary.PaidLots)
                                    {
                                        <MudText Typo="Typo.body2">@ProfileCreditPresenter.BuildPaidLotCopy(paidLot)</MudText>
                                    }
                                </MudStack>
                            }

                            @if (ShowCreditPackCatalog && CreditPackCatalog.Count > 0)
                            {
                                <MudDivider Class="my-2" />
                                <MudStack Spacing="2">
                                    <MudText Typo="Typo.subtitle2">@ProfileCreditPresenter.BuildBuyCreditsSectionHeading()</MudText>
                                    @foreach (var packChoice in CreditPackCatalog)
                                    {
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                                            <MudText Typo="Typo.body2">@packChoice.DisplayLabel</MudText>
                                            <MudButton Variant="Variant.Outlined"
                                                       Color="Color.Primary"
                                                       Size="Size.Small"
                                                       Disabled="@(isStartingCreditCheckout)"
                                                       OnClick="@(() => StartCreditCheckoutForPackAsync(packChoice.PackId))">
                                                @ProfileCreditPresenter.BuildBuyPackActionLabel()
                                            </MudButton>
                                        </MudStack>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(creditCheckoutUserMessage))
                                    {
                                        <MudAlert Severity="Severity.Warning" Dense="true">
                                            @creditCheckoutUserMessage
                                        </MudAlert>
                                    }
                                </MudStack>
                            }
                        }

                        <MudDivider Class="my-2" />
                        <MudText Typo="Typo.subtitle2">@ProfileCreditPresenter.BuildActivityHeading()</MudText>

                        @if (creditActivityLoading)
                        {
                            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                        }
                        else if (!string.IsNullOrWhiteSpace(creditActivityErrorMessage))
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true">
                                <MudText Typo="Typo.body2">@creditActivityErrorMessage</MudText>
                            </MudAlert>
                        }
                        else if (creditActivity is not null)
                        {
                            @if (creditActivity.HasOlderHistory)
                            {
                                <MudAlert Severity="Severity.Info" Dense="true">
                                    <MudText Typo="Typo.body2">@ProfileCreditPresenter.BuildOlderHistoryNotice()</MudText>
                                </MudAlert>
                            }

                            @if (creditActivity.Entries.Count == 0)
                            {
                                <MudText Typo="Typo.body2">No credit activity in the last twelve months.</MudText>
                            }
                            else
                            {
                                <MudSimpleTable Dense="true" Elevation="0">
                                    <thead>
                                        <tr>
                                            <th>When (UTC)</th>
                                            <th>Activity</th>
                                            <th>Credits</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var entry in creditActivity.Entries)
                                        {
                                            <tr>
                                                <td>@entry.OccurredUtc.UtcDateTime.ToString("dd MMM yyyy HH:mm", System.Globalization.CultureInfo.InvariantCulture)</td>
                                                <td>@ProfileCreditPresenter.BuildActivityKindLabel(entry.ActivityKind)</td>
                                                <td>@ProfileCreditPresenter.BuildActivityQuantityCopy(entry)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </MudSimpleTable>
                            }
                        }
                    </MudStack>
                </MudPaper>
            }

            <MudPaper Elevation="0" Outlined="true" Class="pa-4 pa-md-6">
                @if (account.Status == CommercialAccountStatus.Deleted)
                {
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.h6">Account deletion status</MudText>
                        @if (account.RetentionExpiresUtc is not null)
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true">
                                This account is scheduled for deletion on @account.RetentionExpiresUtc.Value.UtcDateTime.ToString("dd MMM yyyy", System.Globalization.CultureInfo.InvariantCulture).
                            </MudAlert>
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true">
                                This account is scheduled for deletion after the retention period.
                            </MudAlert>
                        }
                    </MudStack>
                }
                else
                {
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.h6">Delete account</MudText>
                        <MudText Typo="Typo.body2">
                            Deleting your account blocks access immediately and starts a 6-month retention period before permanent removal.
                        </MudText>
                        @if (!showDeleteConfirmation)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="OnDeleteRequested">
                                Delete account
                            </MudButton>
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true">
                                Confirm account deletion to continue.
                            </MudAlert>
                            <MudStack Row="true" Spacing="2">
                                <MudButton Variant="Variant.Filled" Color="Color.Error" Disabled="@isDeletingAccount" OnClick="OnDeleteConfirmedAsync">
                                    Confirm delete account
                                </MudButton>
                                <MudButton Variant="Variant.Text" Color="Color.Inherit" Disabled="@isDeletingAccount" OnClick="OnDeleteCancelled">
                                    Cancel
                                </MudButton>
                            </MudStack>
                        }
                    </MudStack>
                }
            </MudPaper>
        }
    </MudStack>
</MudContainer>
