@namespace ImportToPlanner.Web.Features.Import.Pages
@using ImportToPlanner.Web.Features.Import.Presenters
@using Microsoft.JSInterop
@using MudBlazor
@inject ImportExecutionPresenter ExecutionPresenter
@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar

@if (ExecutionResult is not null)
{
    <MudStack Spacing="2">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
            <MudText Typo="Typo.h6">Execution Report</MudText>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       Disabled="@(!ExecutionResult.HasExportableContent)"
                       aria-label="Download execution report as CSV"
                       OnClick="DownloadReportAsync">
                Download report
            </MudButton>
        </MudStack>

        @if (ExecutionResult.PlanId is not null)
        {
            @if (ExecutionResult.Errors.Count == 0)
            {
                <MudAlert Severity="Severity.Success" Dense="true">
                    Import complete. <a href="https://planner.cloud.microsoft/webui/plan/@ExecutionResult.PlanId"
                                        target="_blank" rel="noopener noreferrer">Open plan in Planner</a>
                </MudAlert>
            }
            else
            {
                <MudAlert Severity="Severity.Warning" Dense="true">
                    Import finished with errors. <a href="https://planner.cloud.microsoft/webui/plan/@ExecutionResult.PlanId"
                                                    target="_blank" rel="noopener noreferrer">Open plan in Planner</a>
                </MudAlert>
            }
        }

        <MudTabs Rounded="false" ApplyEffectsToContainer="false">
            <MudTabPanel Text="Summary">
                <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" Class="mb-3">
                    <MudChip T="string" Color="Color.Success" Variant="Variant.Outlined" Size="Size.Small">Created: @ExecutionResult.Created.Count</MudChip>
                    <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Size="Size.Small">Skipped: @ExecutionResult.ReusedOrSkipped.Count</MudChip>
                    <MudChip T="string" Color="Color.Warning" Variant="Variant.Outlined" Size="Size.Small">Manual: @ExecutionResult.ManualActions.Count</MudChip>
                    <MudChip T="string" Color="Color.Error" Variant="Variant.Outlined" Size="Size.Small">Errors: @ExecutionResult.Errors.Count</MudChip>
                </MudStack>

                <MudSimpleTable Dense="true" Hover="true" Elevation="0">
                    <thead>
                        <tr>
                            <th>Section</th>
                            <th>Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Tasks created</td>
                            <td>@ExecutionResult.TasksCreatedCount</td>
                        </tr>
                        @if (ExecutionResult.CreditsUsed is not null)
                        {
                            <tr>
                                <td>Credits used (free monthly)</td>
                                <td>@ExecutionResult.CreditsUsed</td>
                            </tr>
                            <tr>
                                <td>Remaining credits</td>
                                <td>@ExecutionResult.RemainingCredits</td>
                            </tr>
                        }
                        <tr>
                            <td>Created</td>
                            <td>@ExecutionResult.Created.Count</td>
                        </tr>
                        <tr>
                            <td>Reused or skipped</td>
                            <td>@ExecutionResult.ReusedOrSkipped.Count</td>
                        </tr>
                        <tr>
                            <td>Manual actions</td>
                            <td>@ExecutionResult.ManualActions.Count</td>
                        </tr>
                        <tr>
                            <td>Errors</td>
                            <td>@ExecutionResult.Errors.Count</td>
                        </tr>
                    </tbody>
                </MudSimpleTable>

                @if (ExecutionResult.Created.Count > 0)
                {
                    <MudText Typo="Typo.subtitle2" Class="mt-3">Created</MudText>
                    <MudDataGrid Items="@ExecutionResult.Created" T="string" Dense="true" ReadOnly="true">
                        <Columns>
                            <PropertyColumn Property="@(item => item)" Title="Item" />
                        </Columns>
                    </MudDataGrid>
                }

                @if (ExecutionResult.ReusedOrSkipped.Count > 0)
                {
                    <MudText Typo="Typo.subtitle2" Class="mt-3">Reused or skipped</MudText>
                    <MudDataGrid Items="@ExecutionResult.ReusedOrSkipped" T="string" Dense="true" ReadOnly="true">
                        <Columns>
                            <PropertyColumn Property="@(item => item)" Title="Item" />
                        </Columns>
                    </MudDataGrid>
                }
            </MudTabPanel>

            <MudTabPanel Text="@($"Manual Actions ({ExecutionResult.ManualActions.Count})")">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                    <MudText Typo="Typo.subtitle2">Manual actions</MudText>
                    <MudChip T="string" Color="Color.Warning" Variant="Variant.Outlined" Size="Size.Small">@ExecutionResult.ManualActions.Count</MudChip>
                </MudStack>

                @if (ExecutionResult.ManualActions.Count == 0)
                {
                    <MudAlert Severity="Severity.Success" Dense="true">None</MudAlert>
                }
                else
                {
                    <MudDataGrid Items="@ExecutionResult.ManualActions" T="ManualActionViewModel" Dense="true" ReadOnly="true">
                        <Columns>
                            <TemplateColumn Title="Action type">
                                <CellTemplate>
                                    <MudChip T="string" Color="@GetManualActionColour(context.Item.ActionType)" Variant="Variant.Filled" Size="Size.Small">
                                        @context.Item.ActionType
                                    </MudChip>
                                </CellTemplate>
                            </TemplateColumn>
                            <PropertyColumn Property="@(item => item.GoalName)" Title="Goal" />
                            <PropertyColumn Property="@(item => item.TaskName)" Title="Task" />
                            <PropertyColumn Property="@(item => item.Details)" Title="Details" />
                        </Columns>
                    </MudDataGrid>
                }
            </MudTabPanel>

            <MudTabPanel Text="@($"Errors ({ExecutionResult.Errors.Count})")">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                    <MudText Typo="Typo.subtitle2">Errors</MudText>
                    <MudChip T="string" Color="Color.Error" Variant="Variant.Outlined" Size="Size.Small">@ExecutionResult.Errors.Count</MudChip>
                </MudStack>

                @if (ExecutionResult.Errors.Count == 0)
                {
                    <MudAlert Severity="Severity.Success" Dense="true">None</MudAlert>
                }
                else
                {
                    <MudDataGrid Items="@ExecutionResult.Errors" T="string" Dense="true" ReadOnly="true">
                        <Columns>
                            <PropertyColumn Property="@(item => item)" Title="Error" />
                        </Columns>
                    </MudDataGrid>
                }
            </MudTabPanel>
        </MudTabs>
    </MudStack>
}

@code {
    [Parameter]
    public ImportExecutionReportViewModel? ExecutionResult { get; set; }

    private async Task DownloadReportAsync()
    {
        var file = ExecutionPresenter.TryBuildExecutionReportCsvDownload(ExecutionResult);
        if (file is null)
        {
            Snackbar.Add("Could not generate the report file. Try running the import again.", Severity.Warning);
            return;
        }

        try
        {
            await JSRuntime.InvokeVoidAsync(
                "importToPlannerExecutionReportDownload.downloadCsv",
                file.FileName,
                Convert.ToBase64String(file.Content));
        }
        catch (JSDisconnectedException)
        {
            Snackbar.Add("The download could not start because the connection was interrupted. Refresh the page and try again.", Severity.Warning);
        }
        catch (JSException)
        {
            Snackbar.Add("The download could not start. Refresh the page and try again.", Severity.Warning);
        }
    }

    private static Color GetManualActionColour(string actionType)
        => actionType switch
        {
            "Ensure Goal Exists" => Color.Warning,
            "Link Task To Goal" => Color.Info,
            _ => Color.Default,
        };
}
