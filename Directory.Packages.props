<Project>
  <PropertyGroup>
    <!--
      Enable Central Package Management (CPM) so package versions are declared once
      in this file and referenced version-less from individual project files.
    -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Test and coverage tooling -->
    <PackageVersion Include="bunit" Version="2.9.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="MessagePack" Version="2.5.302" />
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="AngleSharp" Version="1.7.2" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.11" />

    <!-- CSV parsing -->
    <PackageVersion Include="CsvHelper" Version="33.1.0" />

    <!-- Blazor UI (MudBlazor) -->
    <PackageVersion Include="MudBlazor" Version="9.9.0" />

    <!-- Microsoft Graph & Kiota -->
    <PackageVersion Include="Microsoft.Graph" Version="6.5.0" />
    <PackageVersion Include="Microsoft.Kiota.Abstractions" Version="2.0.0" />

    <!-- Identity / Authentication -->
    <PackageVersion Include="Microsoft.Identity.Web" Version="4.14.2" />
    <PackageVersion Include="Microsoft.Identity.Web.UI" Version="4.14.2" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />

    <!-- Azure SDKs -->
    <PackageVersion Include="Aspire.Azure.Data.Tables" Version="13.5.3" />
    <PackageVersion Include="Aspire.Azure.Storage.Blobs" Version="13.5.3" />
    <PackageVersion Include="Azure.Data.Tables" Version="12.12.0" />
    <PackageVersion Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" Version="1.5.4" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.29.2" />

    <!-- Aspire AppHost -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageVersion Include="Aspire.Hosting.Azure.AppContainers" Version="13.5.3" />
    <PackageVersion Include="Aspire.Hosting.Azure.Storage" Version="13.5.3" />

    <!-- Resilience & Service Discovery -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.9.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.9.0" />

    <!-- OpenTelemetry exporters and instrumentation -->
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.18.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.OpenApi" Version="2.7.5" />
  </ItemGroup>
</Project>
